<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LizTerm.App.Controls"
        xmlns:rendering="using:LizTerm.App.Rendering"
        x:Class="LizTerm.App.Views.AboutWindow"
        Title="About LizTerm" Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <!-- Fluent's Button swaps in a grey fill and its own foreground under the pointer and while pressed; the
         dedication link keeps its orange and no fill in every state. -->
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{x:Static rendering:Palette.DedicationLink}" />
    </Style>
    <Style Selector="Button.link:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{x:Static rendering:Palette.DedicationLink}" />
    </Style>
  </Window.Styles>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12">
      <Image x:Name="AboutMark" Source="avares://LizTerm.App/Assets/Icons/lizterm-256.png"
             Width="56" Height="56" Stretch="Uniform" VerticalAlignment="Center" />
      <TextBlock Text="LizTerm" FontFamily="{x:Static controls:TerminalScreen.TerminalFont}" FontSize="40" Foreground="#50FF50" VerticalAlignment="Center" />
    </StackPanel>
    <!-- The version and engine lines are selectable, unlike the rest: on a build that is not a release the version
         carries the commit, the engine line names the b3270 and where it came from, and the bug report template
         asks for both by quoting them. IsTabStop="False" because a SelectableTextBlock is focusable where a
         TextBlock is not, and these are the first controls in the panel: without it, Tab in About lands on a line
         of text before it reaches the link or Close. -->
    <SelectableTextBlock DockPanel.Dock="Top" x:Name="VersionText" Margin="0,4,0,0" IsTabStop="False" />
    <SelectableTextBlock DockPanel.Dock="Top" x:Name="EngineText" Margin="0,12,0,0" TextWrapping="Wrap" IsTabStop="False" />
    <TextBlock DockPanel.Dock="Top" x:Name="CopyrightText" Margin="0,12,0,0" TextWrapping="Wrap" />
    <!-- LizTerm is named for Liz (README, "The name"), and this opens her photo. A Button made to look like a link
         rather than a HyperlinkButton, whose Fluent foreground is the platform accent: on macOS that is whatever the
         user picked, graphite included. Underlined and led by a picture icon so the orange never carries "link"
         alone; the icon is drawn because the 3270 font has no such glyph and a fallback glyph differs per platform. -->
    <Button x:Name="DedicationLink" DockPanel.Dock="Top" Classes="link" Margin="0,8,0,0" HorizontalAlignment="Left"
            Padding="0" MinHeight="0" Background="Transparent" BorderThickness="0" Cursor="Hand"
            Foreground="{x:Static rendering:Palette.DedicationLink}" Click="OnDedicationClick">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Canvas Width="14" Height="14" VerticalAlignment="Center">
          <Rectangle Canvas.Left="0.75" Canvas.Top="2" Width="12.5" Height="10" RadiusX="1.5" RadiusY="1.5"
                     Stroke="{x:Static rendering:Palette.DedicationLink}" StrokeThickness="1.3" />
          <Ellipse Canvas.Left="3.2" Canvas.Top="4.2" Width="2.4" Height="2.4" Fill="{x:Static rendering:Palette.DedicationLink}" />
          <Path Data="M 2,11 L 5.5,7.5 L 8,10 L 9.5,8.5 L 12,11" Stroke="{x:Static rendering:Palette.DedicationLink}"
                StrokeThickness="1.3" StrokeJoin="Round" StrokeLineCap="Round" />
        </Canvas>
        <TextBlock x:Name="DedicationText" Text="Dedicated to Liz, my mainframe cat" TextDecorations="Underline"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Button>
    <TextBlock DockPanel.Dock="Top" Text="Licenses" Margin="0,16,0,4" FontWeight="SemiBold" />
    <Button DockPanel.Dock="Bottom" Content="Close" HorizontalAlignment="Right" Margin="0,12,0,0" IsDefault="True" IsCancel="True" Click="OnCloseClick" />
    <!-- One scroll region, LizTerm's own terms first. The heading was "Third-party notices" while LizTerm had
         no license of its own to show; it has one now, and it is not third-party. -->
    <TextBox x:Name="LicensesText" Height="220" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" />
  </DockPanel>
</Window>
