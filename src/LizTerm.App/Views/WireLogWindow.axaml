<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:LizTerm.App.Controls"
        x:Class="LizTerm.App.Views.WireLogWindow"
        Title="Start a wire log?" Width="520" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16" Spacing="12">
    <!-- A caution banner, matching the mvsMF preview strip: dark text on yellow, with the mark carrying the
         warning as much as the colour does. -->
    <Border Background="#F5C542" Padding="12,8">
      <TextBlock Text="⚠ A wire log records the whole session, in both directions."
                 Foreground="#101010" FontWeight="SemiBold" TextWrapping="Wrap" />
    </Border>
    <StackPanel Spacing="6">
      <TextBlock TextWrapping="Wrap" Text="• Everything you type, including passwords — and a password typed as part of a longer command, such as LOGON USER/SECRET, is recorded in full." />
      <TextBlock TextWrapping="Wrap" Text="• Every screen the host sends, so whatever data this session displays." />
    </StackPanel>
    <TextBlock TextWrapping="Wrap" Text="Nothing removes the file and nothing edits it for you. Read it before you send it to anyone." />
    <StackPanel Spacing="4">
      <TextBlock Text="The log will be written to:" Foreground="#A0A0A0" FontSize="12" />
      <TextBlock x:Name="PathText" FontFamily="{x:Static controls:TerminalScreen.TerminalFont}" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button x:Name="StartButton" Content="Start Wire Log" Click="OnStartClick" />
      <Button x:Name="CancelButton" Content="Cancel" IsDefault="True" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </StackPanel>
</Window>
