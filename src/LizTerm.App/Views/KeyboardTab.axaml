<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LizTerm.App.ViewModels"
             xmlns:controls="using:LizTerm.App.Controls"
             x:Class="LizTerm.App.Views.KeyboardTab"
             x:DataType="vm:KeymapEditorViewModel">
  <!-- The Keyboard tab (#18). Its data context is the KeymapEditorViewModel, not the Preferences window's
       SettingsViewModel, so PreferencesWindow sets it. One row per action: the name on the left, its chords as
       chips (each with a × that removes it) and the Add slot on the right. Colour never carries meaning alone: the
       armed slot reads "Press a key" and has a thicker border, a refusal is text, a chip has its ×. -->
  <!-- TextBlock.hint is PreferencesWindow's style: a window's styles reach the tab it hosts, so it is not repeated. -->
  <UserControl.Styles>
    <!-- ChordCaptureBox is a Button under another type, so it is styled by class, not by type. -->
    <Style Selector="Button.chord-slot, Button.cancel">
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Margin" Value="6,0,0,4" />
    </Style>
    <Style Selector="Button.chord-slot">
      <Setter Property="MinWidth" Value="84" />
      <Setter Property="MaxWidth" Value="180" />
    </Style>
    <Style Selector="Button.chord-slot:armed">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button.remove">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </UserControl.Styles>
  <DockPanel>
    <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
      <!-- Hidden until a save fails; the session windows show the same message in their banners. Named for the keymap
           rather than SaveErrorText, which is the Preferences window's own settings failure, in the same window.
           Outside EditorFooter because a failed reset has to be readable while the load error is what is showing. -->
      <TextBlock x:Name="KeymapSaveErrorText" Text="{Binding SaveError}" IsVisible="{Binding HasSaveError}"
                 Foreground="#FF8080" TextWrapping="Wrap" />
      <StackPanel x:Name="EditorFooter" Spacing="6" IsVisible="{Binding !HasLoadError}">
        <TextBlock x:Name="UnreadableText" Classes="hint" Text="{Binding UnreadableNote}" IsVisible="{Binding HasUnreadable}"
                   TextWrapping="Wrap" />
        <Button x:Name="ResetButton" Content="Reset to defaults" Command="{Binding ResetCommand}" />
      </StackPanel>
    </StackPanel>
    <!-- One cell, two states (#168). A keymap.json this build cannot read at all leaves nothing to edit — every
         default is in force and KeymapStore.Update would refuse every save — so the rows go and the reason, the
         file and the one way out take their place. Words, not colour, carry which state this is. -->
    <Panel>
    <StackPanel x:Name="LoadErrorPanel" Spacing="8" IsVisible="{Binding HasLoadError}" VerticalAlignment="Top">
      <TextBlock x:Name="LoadErrorText" Text="{Binding LoadErrorNote}" Foreground="#FF8080" TextWrapping="Wrap" />
      <!-- Selectable so the path can be copied into an editor; the file is the whole point of the message. -->
      <SelectableTextBlock x:Name="LoadErrorPath" Text="{Binding KeymapFilePath}" TextWrapping="Wrap" IsTabStop="False" />
      <TextBlock Classes="hint" TextWrapping="Wrap"
                 Text="Resetting moves the file to keymap.json.bad and starts again from the defaults, so your bindings are still there to read." />
      <Button x:Name="RestoreButton" Content="Reset keymap to defaults" Command="{Binding RestoreCommand}"
              HorizontalAlignment="Left" />
    </StackPanel>
    <ScrollViewer x:Name="RowScroller" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !HasLoadError}">
      <ItemsControl x:Name="RowList" ItemsSource="{Binding Rows}" Margin="0,0,12,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeymapRow">
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" Margin="0,4">
              <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,3,8,0" TextWrapping="Wrap" />
              <DockPanel Grid.Column="1">
                <controls:ChordCaptureBox x:Name="Slot" DockPanel.Dock="Right" CaptureHandler="{Binding CaptureHandler}"
                                          AutomationProperties.Name="{Binding AddName}" />
                <!-- The way out of an armed slot that binds nothing. Shown only while the slot is armed, to its left so
                     the slot stays under the pointer that armed it. Not focusable, and the click hands the focus back
                     to the slot, now idle, so a keyboard user who reached for the mouse can Tab on. The keyboard's own
                     way out is Escape twice, the slot's rule. -->
                <Button DockPanel.Dock="Right" Classes="cancel" Content="Cancel" Focusable="False"
                        IsVisible="{Binding #Slot.IsArmed}" Click="OnCancelClick"
                        AutomationProperties.Name="{Binding CancelName}" />
                <ItemsControl ItemsSource="{Binding Chips}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeymapChip">
                      <Border Background="#303030" CornerRadius="3" Padding="6,0,1,0" Margin="0,0,4,4">
                        <StackPanel Orientation="Horizontal" Spacing="1">
                          <TextBlock Text="{Binding Text}" FontSize="12" VerticalAlignment="Center" />
                          <Button Classes="remove" Content="×" Command="{Binding RemoveCommand}"
                                  AutomationProperties.Name="{Binding RemoveName}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </DockPanel>
              <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Classes="hint" Text="{Binding Note}" IsVisible="{Binding HasNote}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
