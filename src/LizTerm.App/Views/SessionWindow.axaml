<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:LizTerm.App.ViewModels"
        xmlns:controls="using:LizTerm.App.Controls"
        xmlns:rendering="using:LizTerm.App.Rendering"
        xmlns:core="using:LizTerm.Core.Session"
        xmlns:app="using:LizTerm.App"
        x:Class="LizTerm.App.Views.SessionWindow"
        x:DataType="vm:SessionViewModel"
        Title="{Binding Title}"
        Width="960" Height="680" MinWidth="480" MinHeight="360"
        Icon="avares://LizTerm.App/Assets/Icons/lizterm-256.png"
        Background="Black">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="_File">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="_New Session..." Click="OnNewSessionClickNative" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="_Connect" Command="{Binding ConnectCommand}" />
            <NativeMenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="IND$FILE _Transfer..." Click="OnFileTransferClickNative" IsEnabled="{Binding IsConnected}" />
            <NativeMenuItem Header="_Save Screen As..." Click="OnSaveScreenClickNative" IsEnabled="{Binding CanCaptureScreen}" />
            <NativeMenuItem Header="Save as _Profile..." Click="OnSaveAsProfileClickNative" IsEnabled="{Binding CanSaveAsProfile}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="C_lose" Click="OnCloseClickNative" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Edit">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!-- Click rather than Command (a native gesture is a keystroke, and must not be swallowed by a
                 command disabled mid-round-trip), but the same enablement the classic items get from their
                 commands' CanExecute — otherwise macOS offers a live Copy with nothing selected. Safe to bind
                 here because NativeMenuItem only overwrites IsEnabled when its Command changes, and these
                 carry none. -->
            <NativeMenuItem Header="_Copy" Click="OnCopyClickNative" IsEnabled="{Binding CanCopy}" />
            <NativeMenuItem Header="_Paste" Click="OnPasteClickNative" IsEnabled="{Binding IsConnected}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Select _All" Click="OnSelectAllClickNative" IsEnabled="{Binding CanSelectAll}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="Copy Screen as _HTML" Click="OnCopyScreenClickNative" IsEnabled="{Binding CanCaptureScreen}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="_Find..." Click="OnFindClickNative" IsEnabled="{Binding CanFind}" />
            <!-- Hidden with its separator on macOS, where Preferences lives in the application menu. -->
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="P_references..." Click="OnPreferencesClickNative" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_View">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!-- A submenu rather than four bare items: "Horizontal" and "Vertical" sitting alone under View
                 read as window tiling to anyone who has not been told they are the crosshair's, which is what
                 happened the first time someone opened this menu. Nesting states the noun once. -->
            <NativeMenuItem Header="_Crosshair">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <!-- OneWay plus a Click handler, not a TwoWay binding: a NativeMenuItem never toggles itself,
                       so the handler sets the view model and these bindings carry every check mark back —
                       including the three that have to go false. No Gesture: outside Edit, a native gesture is
                       an AppKit key equivalent dispatched ahead of the responder chain, which would take the
                       key from the terminal. Radio renders as a bullet rather than a tick on macOS, which is
                       AppKit's own radio-group mark (verified on a real GUI session 2026-09-10). -->
                  <NativeMenuItem Header="_None" ToggleType="Radio" Click="OnCrosshairNoneClickNative"
                                  IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=None, Mode=OneWay}" />
                  <NativeMenuItem Header="_Horizontal" ToggleType="Radio" Click="OnCrosshairHorizontalClickNative"
                                  IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=Horizontal, Mode=OneWay}" />
                  <NativeMenuItem Header="_Vertical" ToggleType="Radio" Click="OnCrosshairVerticalClickNative"
                                  IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=Vertical, Mode=OneWay}" />
                  <NativeMenuItem Header="_Both" ToggleType="Radio" Click="OnCrosshairBothClickNative"
                                  IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=Both, Mode=OneWay}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
            <!-- A submenu, the Crosshair's structure, because the dock belongs beside the thing it docks and
                 "At the Bottom" under View on its own names nothing (#71). What it cannot copy is the Crosshair's
                 single radio group: these are two settings, not one enum — keypad spec §2.1 rejected an enum with
                 a Hidden member because it would forget the dock every time the keypad was hidden — so the
                 separator is the seam between them rather than decoration. The wording is shorter than the same
                 settings in Preferences, whose radios sit under a bare "Keypad" heading with the whole window as
                 context; inside a submenu already named Keypad, "At the Bottom" is the whole sentence.
                 One-way plus Click throughout, the Crosshair items' shape: a NativeMenuItem never toggles itself,
                 and the handlers write the view model, whose change reaches every window's panel and check mark.
                 No Gesture on any of them: nothing outside Edit carries one (keypad spec §6.3). -->
            <NativeMenuItem Header="_Keypad">
              <NativeMenuItem.Menu>
                <NativeMenu>
                  <NativeMenuItem Header="_Show the Keypad" ToggleType="CheckBox" Click="OnKeypadClickNative"
                                  IsChecked="{Binding Settings.Keypad, Mode=OneWay}" />
                  <NativeMenuItemSeparator />
                  <NativeMenuItem Header="At the _Bottom" ToggleType="Radio" Click="OnKeypadBottomClickNative"
                                  IsChecked="{Binding Settings.KeypadDock, Converter={x:Static vm:KeypadDockConverter.Instance}, ConverterParameter=Bottom, Mode=OneWay}" />
                  <NativeMenuItem Header="On the _Right" ToggleType="Radio" Click="OnKeypadRightClickNative"
                                  IsChecked="{Binding Settings.KeypadDock, Converter={x:Static vm:KeypadDockConverter.Instance}, ConverterParameter=Right, Mode=OneWay}" />
                </NativeMenu>
              </NativeMenuItem.Menu>
            </NativeMenuItem>
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Keys">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Clear" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Clear}" />
            <NativeMenuItem Header="Reset" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Reset}" />
            <NativeMenuItem Header="Attn" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Attn}" />
            <NativeMenuItem Header="SysReq" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.SysReq}" />
            <NativeMenuItem Header="Dup" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Dup}" />
            <NativeMenuItem Header="Field Mark" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.FieldMark}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="PA1" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PA1}" />
            <NativeMenuItem Header="PA2" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PA2}" />
            <NativeMenuItem Header="PA3" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PA3}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="PF13" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF13}" />
            <NativeMenuItem Header="PF14" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF14}" />
            <NativeMenuItem Header="PF15" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF15}" />
            <NativeMenuItem Header="PF16" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF16}" />
            <NativeMenuItem Header="PF17" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF17}" />
            <NativeMenuItem Header="PF18" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF18}" />
            <NativeMenuItem Header="PF19" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF19}" />
            <NativeMenuItem Header="PF20" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF20}" />
            <NativeMenuItem Header="PF21" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF21}" />
            <NativeMenuItem Header="PF22" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF22}" />
            <NativeMenuItem Header="PF23" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF23}" />
            <NativeMenuItem Header="PF24" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF24}" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
      <NativeMenuItem Header="_Help">
        <NativeMenuItem.Menu>
          <NativeMenu>
            <!-- OneWay plus a Click handler, unlike the classic item's TwoWay: a NativeMenuItem never toggles
                 itself. See OnWireLogClickNative. -->
            <NativeMenuItem Header="_User Guide" Command="{Binding ShowUserGuideCommand}" />
            <NativeMenuItem Header="Project on _GitHub" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static app:ProjectLinks.Repository}" />
            <NativeMenuItem Header="_Report an Issue..." Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static app:ProjectLinks.NewIssue}" />
            <NativeMenuItem Header="R_eleases" Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static app:ProjectLinks.Releases}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="_Wire Log" ToggleType="CheckBox" IsChecked="{Binding IsWireLogging, Mode=OneWay}"
                            Click="OnWireLogClickNative" />
            <NativeMenuItem Header="Show Wire _Logs..." Command="{Binding ShowWireLogsCommand}" />
            <NativeMenuItemSeparator />
            <NativeMenuItem Header="_About LizTerm..." Click="OnAboutClickNative" />
          </NativeMenu>
        </NativeMenuItem.Menu>
      </NativeMenuItem>
    </NativeMenu>
  </NativeMenu.Menu>
  <DockPanel>
    <NativeMenuBar x:Name="NativeBar" DockPanel.Dock="Top" />
    <Menu x:Name="ClassicMenu" DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="_New Session..." Click="OnNewSessionClick" />
        <Separator />
        <MenuItem Header="_Connect" Command="{Binding ConnectCommand}" />
        <MenuItem Header="_Disconnect" Command="{Binding DisconnectCommand}" />
        <Separator />
        <MenuItem x:Name="FileTransferMenuItem" Header="IND$FILE _Transfer..." Click="OnFileTransferClick" IsEnabled="{Binding IsConnected}" />
        <MenuItem Header="_Save Screen As..." Click="OnSaveScreenClick" IsEnabled="{Binding CanCaptureScreen}" />
        <MenuItem Header="Save as _Profile..." Click="OnSaveAsProfileClick" IsEnabled="{Binding CanSaveAsProfile}" />
        <Separator />
        <MenuItem Header="C_lose" Click="OnCloseClick" />
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="CopyMenuItem" Header="_Copy" Command="{Binding CopyCommand}" />
        <MenuItem x:Name="PasteMenuItem" Header="_Paste" Command="{Binding PasteCommand}" />
        <Separator />
        <MenuItem x:Name="SelectAllMenuItem" Header="Select _All" Command="{Binding SelectAllCommand}" />
        <Separator />
        <MenuItem Header="Copy Screen as _HTML" Command="{Binding CopyScreenAsHtmlCommand}" />
        <Separator />
        <MenuItem x:Name="FindMenuItem" Header="_Find..." Click="OnFindClick" IsEnabled="{Binding CanFind}" />
        <!-- Hidden with the item below it on macOS, as AboutSeparator is. -->
        <Separator x:Name="PreferencesSeparator" />
        <MenuItem x:Name="PreferencesMenuItem" Header="P_references..." Click="OnPreferencesClick" />
      </MenuItem>
      <MenuItem Header="_View">
        <MenuItem Header="_Crosshair">
          <MenuItem Header="_None" ToggleType="Radio" GroupName="Crosshair" Click="OnCrosshairNoneClick"
                    IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=None, Mode=OneWay}" />
          <MenuItem Header="_Horizontal" ToggleType="Radio" GroupName="Crosshair" Click="OnCrosshairHorizontalClick"
                    IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=Horizontal, Mode=OneWay}" />
          <MenuItem Header="_Vertical" ToggleType="Radio" GroupName="Crosshair" Click="OnCrosshairVerticalClick"
                    IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=Vertical, Mode=OneWay}" />
          <MenuItem Header="_Both" ToggleType="Radio" GroupName="Crosshair" Click="OnCrosshairBothClick"
                    IsChecked="{Binding Settings.Crosshair, Converter={x:Static vm:CrosshairModeConverter.Instance}, ConverterParameter=Both, Mode=OneWay}" />
        </MenuItem>
        <!-- The same shape as the native submenu and the Crosshair radios above, so the two menus stay alike and
             Wire Log stays the one item whose two menus differ. GroupName on the radios is the classic side's
             own requirement; the native items have no group to name. -->
        <MenuItem Header="_Keypad">
          <MenuItem x:Name="KeypadShowMenuItem" Header="_Show the Keypad" ToggleType="CheckBox" Click="OnKeypadClick"
                    IsChecked="{Binding Settings.Keypad, Mode=OneWay}" />
          <Separator />
          <MenuItem x:Name="KeypadDockBottomMenuItem" Header="At the _Bottom" ToggleType="Radio" GroupName="KeypadDock" Click="OnKeypadBottomClick"
                    IsChecked="{Binding Settings.KeypadDock, Converter={x:Static vm:KeypadDockConverter.Instance}, ConverterParameter=Bottom, Mode=OneWay}" />
          <MenuItem x:Name="KeypadDockRightMenuItem" Header="On the _Right" ToggleType="Radio" GroupName="KeypadDock" Click="OnKeypadRightClick"
                    IsChecked="{Binding Settings.KeypadDock, Converter={x:Static vm:KeypadDockConverter.Instance}, ConverterParameter=Right, Mode=OneWay}" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Keys">
        <MenuItem Header="Clear" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Clear}" />
        <MenuItem Header="Reset" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Reset}" />
        <MenuItem Header="Attn" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Attn}" />
        <MenuItem Header="SysReq" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.SysReq}" />
        <MenuItem Header="Dup" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.Dup}" />
        <MenuItem Header="Field Mark" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.FieldMark}" />
        <Separator />
        <MenuItem Header="PA1" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PA1}" />
        <MenuItem Header="PA2" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PA2}" />
        <MenuItem Header="PA3" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PA3}" />
        <Separator />
        <MenuItem Header="PF13" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF13}" />
        <MenuItem Header="PF14" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF14}" />
        <MenuItem Header="PF15" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF15}" />
        <MenuItem Header="PF16" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF16}" />
        <MenuItem Header="PF17" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF17}" />
        <MenuItem Header="PF18" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF18}" />
        <MenuItem Header="PF19" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF19}" />
        <MenuItem Header="PF20" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF20}" />
        <MenuItem Header="PF21" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF21}" />
        <MenuItem Header="PF22" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF22}" />
        <MenuItem Header="PF23" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF23}" />
        <MenuItem Header="PF24" Command="{Binding SendKeyCommand}" CommandParameter="{x:Static core:TerminalKey.PF24}" />
      </MenuItem>
      <MenuItem Header="_Help">
        <MenuItem Header="_User Guide" Command="{Binding ShowUserGuideCommand}" />
        <MenuItem Header="Project on _GitHub" Command="{Binding OpenLinkCommand}"
                  CommandParameter="{x:Static app:ProjectLinks.Repository}" />
        <MenuItem Header="_Report an Issue..." Command="{Binding OpenLinkCommand}"
                  CommandParameter="{x:Static app:ProjectLinks.NewIssue}" />
        <MenuItem Header="R_eleases" Command="{Binding OpenLinkCommand}"
                  CommandParameter="{x:Static app:ProjectLinks.Releases}" />
        <Separator />
        <MenuItem x:Name="WireLogMenuItem" Header="_Wire Log" ToggleType="CheckBox" IsChecked="{Binding IsWireLogging, Mode=TwoWay}" />
        <MenuItem Header="Show Wire _Logs..." Command="{Binding ShowWireLogsCommand}" />
        <!-- Hidden with the item below it on macOS, where About lives in the application menu: a menu that ends
             in a divider is what leaving it behind looks like. -->
        <Separator x:Name="AboutSeparator" />
        <MenuItem x:Name="AboutMenuItem" Header="_About LizTerm..." Click="OnAboutClick" />
      </MenuItem>
    </Menu>

    <!-- Ruled off from the screen in the palette's blue, as x3270 rules off its OIA. -->
    <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="#181818" Padding="10,4"
            BorderThickness="0,1,0,0" BorderBrush="{x:Static rendering:Palette.OiaRule}">
      <Grid ColumnDefinitions="Auto,10,Auto,16,Auto,16,Auto,*,Auto,16,Auto,16,Auto,16,Auto">
        <Grid.Styles>
          <!-- The OIA's colours: x3270's neutral white for text, red for operator errors; the TLS pair is green
               when the certificate was verified and amber when not, and its mark says the same, so a reader who
               cannot tell the two apart is not left guessing (Robert's own call, 2026-09-13). -->
          <Style Selector="TextBlock.oia">
            <Setter Property="FontFamily" Value="{x:Static controls:TerminalScreen.TerminalFont}" />
            <!-- One more row of the screen's own cells, as a real 3270's OIA is: the size follows the screen's
                 fit (Robert's ask at first QA, 2026-09-13). The screen holds it through one-pixel wobbles, since
                 the bar's height is part of what the screen fits into; see StatusBarFont. -->
            <Setter Property="FontSize" Value="{Binding #Screen.OiaFontSize}" />
            <Setter Property="Foreground" Value="#C0C0C0" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
          <Style Selector="TextBlock.oia.error">
            <Setter Property="Foreground" Value="#FF8080" />
          </Style>
          <Style Selector="TextBlock.oia.tls">
            <Setter Property="Foreground" Value="#E8B04B" />
          </Style>
          <Style Selector="TextBlock.oia.tls.verified">
            <Setter Property="Foreground" Value="#5FD35F" />
          </Style>
        </Grid.Styles>
        <!-- The session's identity leads the bar and its state follows (#93): the note icon, then the profile's
             chips when Preferences says so. The icon is a filled vector rather than a glyph because the IBM 3270
             font has no such character and a fallback glyph differs per platform; its disc is the picker's
             note grey, brighter under the pointer. Always present, even with no note, so the banner is one
             click away in every session. The chips are the one part behind a setting: some want PROD in sight
             at all times and others find the bar cluttered. They are also the first thing clipped when the
             window is narrow, which is what leading the bar costs; the state text keeps its place. -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="NoteIcon" Click="OnNoteIconClick" ToolTip.Tip="{Binding Note}"
                  Background="Transparent" Padding="0" BorderThickness="0" MinWidth="0" MinHeight="0"
                  VerticalAlignment="Center" Cursor="Hand">
            <Button.Styles>
              <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
              </Style>
              <Style Selector="Button:pointerover Ellipse.disc">
                <Setter Property="Fill" Value="#DADADA" />
              </Style>
            </Button.Styles>
            <!-- Drawn at 14 and scaled to the OIA's font size, so the icon keeps pace with the glyphs beside it. -->
            <Viewbox Width="{Binding #Screen.OiaFontSize}" Height="{Binding #Screen.OiaFontSize}">
              <Canvas Width="14" Height="14">
                <Ellipse Classes="disc" Width="14" Height="14" Fill="#A8A8A8" />
                <Rectangle Canvas.Left="6.2" Canvas.Top="5.9" Width="1.6" Height="4.8" RadiusX="0.5" RadiusY="0.5" Fill="#181818" />
                <Ellipse Canvas.Left="6.05" Canvas.Top="2.9" Width="1.9" Height="1.9" Fill="#181818" />
              </Canvas>
            </Viewbox>
          </Button>
          <ItemsControl x:Name="StatusChips" ItemsSource="{Binding Chips}" IsVisible="{Binding Settings.ShowTagsInStatusBar}"
                        ItemsPanel="{StaticResource TagChipStrip}" ItemTemplate="{StaticResource TagChipTemplate}"
                        VerticalAlignment="Center" />
        </StackPanel>
        <!-- From here the bar is x3270's Operator Information Area, in its order: the mode field, the message
             area, then insert, LU name and cursor on the right; the padlock sits between mode and message because
             x3270 has no cell for TLS at all. Glyphs on the bar, words on the tooltips (StatusFormatter). The
             padlock and its mark are two blocks so the mark can stand a hair off the padlock: with none, the
             font's monospace cells butt them together. -->
        <TextBlock x:Name="ModeField" Grid.Column="2" Classes="oia" Text="{Binding ModeText}" ToolTip.Tip="{Binding ModeTip}" />
        <StackPanel x:Name="TlsField" Grid.Column="4" Orientation="Horizontal" Spacing="3" ToolTip.Tip="{Binding TlsTip}">
          <TextBlock Classes="oia tls" Classes.verified="{Binding TlsVerified}" Text="{Binding TlsGlyph}" />
          <TextBlock Classes="oia tls" Classes.verified="{Binding TlsVerified}" Text="{Binding TlsMark}" />
        </StackPanel>
        <TextBlock x:Name="MessageArea" Grid.Column="6" Classes="oia" Classes.error="{Binding MessageIsError}"
                   Text="{Binding MessageText}" ToolTip.Tip="{Binding MessageTip}" />
        <TextBlock Grid.Column="8" Classes="oia" Text="{Binding InsertText}" ToolTip.Tip="Insert mode" />
        <TextBlock Grid.Column="10" Classes="oia" Text="{Binding LuText}" ToolTip.Tip="LU name" />
        <TextBlock Grid.Column="12" Classes="oia" Text="{Binding CursorText}" ToolTip.Tip="Cursor row/column" />
        <TextBlock x:Name="WireLogStatus" Grid.Column="14" Classes="oia error" Text="{Binding WireLogText}" />
      </Grid>
    </Border>

    <!-- The connect banner (#93): which box this is, for the moment you have forgotten. Docked here so it sits
         directly above the status bar, under the error and find bars, in the find bar's grey. Shown by the view
         model on the edge into a connected state (when the profile has a note or a chip) or by the icon above,
         and gone on the first keystroke or screen click: no Dismiss, because a note is not an error, and no
         "goes on first keystroke" label either — Robert's call at minimum width (2026-09-13): once learned it is
         obvious, and the pixels belong to the note, which is the line that trims; chips, name and host never
         shrink, and the full note is on the tooltip. -->
    <Border x:Name="NoteBanner" DockPanel.Dock="Bottom" Background="#202020" Padding="10,6"
            IsVisible="{Binding IsBannerVisible}">
      <DockPanel LastChildFill="True">
        <ItemsControl x:Name="BannerChips" DockPanel.Dock="Left" ItemsSource="{Binding Chips}"
                      ItemsPanel="{StaticResource TagChipStrip}" ItemTemplate="{StaticResource TagChipTemplate}"
                      VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="BannerName" DockPanel.Dock="Left" Text="{Binding Profile.Name}" FontWeight="SemiBold"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <TextBlock x:Name="BannerHostPort" DockPanel.Dock="Left" Text="{Binding HostPort}" Foreground="#A0A0A0"
                   VerticalAlignment="Center" Margin="0,0,10,0" />
        <TextBlock x:Name="BannerNote" Text="{Binding Note}" Foreground="#C8C8C8" FontStyle="Italic"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                   IsVisible="{Binding HasNote}" ToolTip.Tip="{Binding Note}" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#5A2020" Padding="10,6"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <DockPanel>
        <Button x:Name="DismissButton" DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissErrorCommand}" Click="OnDismissClick" />
        <TextBlock Text="{Binding ErrorMessage}" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#202020" Padding="10,6"
            IsVisible="{Binding Find.IsOpen}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" Click="OnFindCloseClick" Margin="4,0,0,0" />
        <Button DockPanel.Dock="Right" Content="Next" Click="OnFindNextClick" Margin="4,0,0,0" />
        <Button DockPanel.Dock="Right" Content="Previous" Click="OnFindPreviousClick" Margin="4,0,0,0" />
        <TextBlock DockPanel.Dock="Right" Text="{Binding Find.CountText}" Foreground="#C0C0C0"
                   VerticalAlignment="Center" Margin="10,0" MinWidth="80" />
        <TextBox x:Name="FindBox" Text="{Binding Find.Term, Mode=TwoWay}" KeyDown="OnFindBoxKeyDown"
                 PlaceholderText="Find on screen" />
      </DockPanel>
    </Border>

    <!-- Declared innermost (keypad spec §6.1): at the bottom it sits directly under the screen, above the find,
         error and status bars; on the right it stands beside the screen and above those three, spanning the
         screen's height. Two bindings to one setting: the grid's shape is the control's, its edge of the window is
         this panel's. Invisible costs no layout, and the control builds no buttons until it is first shown.
         IsEnabled follows the connection so a disconnected session shows a greyed keypad rather than buttons that
         silently do nothing. -->
    <controls:Keypad x:Name="KeypadPanel"
                     DockPanel.Dock="{Binding Settings.KeypadDock, Converter={x:Static controls:Keypad.DockPanelDock}}"
                     Dock="{Binding Settings.KeypadDock}"
                     IsVisible="{Binding Settings.Keypad}"
                     IsEnabled="{Binding IsConnected}" />

    <controls:TerminalScreen x:Name="Screen"
                             Snapshot="{Binding Screen}"
                             Selection="{Binding Selection, Mode=TwoWay}"
                             Crosshair="{Binding Settings.Crosshair}"
                             BlinkEnabled="{Binding Settings.Blink}"
                             FindMatches="{Binding Find.Matches}"
                             CurrentMatch="{Binding Find.CurrentMatch}"
                             DestructiveBackspace="{Binding Profile.DestructiveBackspace}" />
  </DockPanel>
</Window>
