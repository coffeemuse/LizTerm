<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LizTerm.App.ViewModels"
             xmlns:render="using:LizTerm.App.Rendering"
             x:Class="LizTerm.App.App"
             Name="LizTerm"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <!-- Every window's icon, set once here so no window names it. :is() because each window is a subclass, and a
         plain Window selector matches only Window itself. The .ico is unlettered at every size, since a title bar
         or taskbar draws it at 16 to 32 px, where the "3270" of lizterm-256.png is a smear; Windows picks the
         nearest of its entries and X11 takes the largest. See "The app icon" in docs/development.md. -->
    <Style Selector=":is(Window)">
      <Setter Property="Icon" Value="avares://LizTerm.App/Assets/Icons/lizterm-window.ico" />
    </Style>
  </Application.Styles>

  <Application.Resources>
    <!-- The tag chip, drawn once: the picker's rows, the session window's status bar and its connect banner
         (#93) all bind these two resources, so a chip cannot look different in the list from the bar. The
         rendering RULES (uppercase, FAVORITE never a chip, the registry's colour) live in TagChip.For; this is
         only the look. -->
    <DataTemplate x:Key="TagChipTemplate" x:DataType="vm:TagChip">
      <Border Background="{Binding Background}" CornerRadius="3" Padding="5,1">
        <TextBlock Text="{Binding Text}" Foreground="{x:Static render:TagPalette.ChipText}" FontSize="10" FontWeight="Bold" />
      </Border>
    </DataTemplate>
    <ItemsPanelTemplate x:Key="TagChipStrip">
      <StackPanel Orientation="Horizontal" Spacing="3" />
    </ItemsPanelTemplate>
  </Application.Resources>

  <!-- The macOS application menu. It hangs off the application rather than a window, which is what gives the
       profile picker a menu bar: the picker is the app's startup state and the state it returns to when the
       last session closes, and until now macOS showed nothing there. Other platforms render none of this.

       About and Preferences are the whole of what we declare, deliberately. Avalonia.Native's AvaloniaNativeMenuExporter.SetMenu
       appends AppKit's standard block — Services, Hide, Hide Others, Show All and Quit — to this very menu
       unless MacOSPlatformOptions.DisableDefaultApplicationMenuItems is set, and Program.cs sets no
       MacOSPlatformOptions. Measured on macOS 15 / Avalonia 12.1.2: our own "Quit LizTerm Cmd+Q" shipped
       alongside Avalonia's "Quit Cmd+Q", two items with one chord and opposite behaviour — ours forced
       Shutdown(), Avalonia's calls TryShutdown(0), which a running IND$FILE transfer correctly refuses through
       FileTransferViewModel.TryClose. The non-forcing one is the semantic this app wants, so ours is gone;
       suppressing the block instead would mean re-implementing Services, Hide, Hide Others and Show All to get
       back what is already there for free. -->
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About LizTerm" Click="OnAboutClick" />
      <NativeMenuItemSeparator />
      <!-- The one gesture outside Edit, on purpose, and the one item AppKit does not supply: see "Gestures" in
           CLAUDE.md. Cmd-comma cannot be a 3270 keystroke (DefaultKeymap binds no Cmd chord). -->
      <NativeMenuItem Header="Preferences..." Gesture="Cmd+OemComma" Click="OnPreferencesClick" />
    </NativeMenu>
  </NativeMenu.Menu>
</Application>
