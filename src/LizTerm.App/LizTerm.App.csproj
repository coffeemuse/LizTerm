<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- The Win32 icon resource inside the executable, which is what Windows draws in the Start menu, on the
         taskbar and in Explorer. Nothing else in the repository produces one: Window.Icon is an Avalonia
         resource the shell cannot read, and LizTerm.parcel's Win32Settings.InstallerIcon dresses the installer
         rather than the application it installs. 0.5.0's rehearsal proved the distinction the hard way, with
         an installer that carried the icon and an installed executable that did not. ApplicationIconTests holds
         this in place. The path is relative to this project, not the repository root. No effect off Windows. -->
    <ApplicationIcon>Assets\Icons\lizterm.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- lizterm.icns and lizterm.ico are read from disk at build and package time, never loaded by the app
         itself: the .icns by Parcel (MacOsSettings.AppIcon), the .ico by Parcel for
         Win32Settings.InstallerIcon and by the SDK for the ApplicationIcon above, which embeds it as a Win32
         resource, a different mechanism from an Avalonia one and the only one the Windows shell reads.
         Embedding them as Avalonia resources cost
         1.71 MB + 0.13 MB of a 3.41 MB assembly for no benefit; excluding them leaves them on disk for their
         real readers while dropping them from the bundle. lizterm.png stays embedded and full-size: Parcel's
         LinuxSettings.AppIcon reads it from disk too, and it is also the 1254x1254 master lizterm-256.png (the
         splash's and About's mark) and every other packaged size of 64 px or more derives from, so do not resize
         it. lizterm-small.png is the unlettered master for the sizes of 48 px or less; only
         tools/build-app-icons.sh reads it, so it stays out of the bundle too. lizterm-window.ico is not
         lizterm.ico: it is the small, unlettered icon App.axaml gives every window, loaded by the app itself,
         so it stays embedded. -->
    <AvaloniaResource Remove="Assets\Icons\lizterm.icns" />
    <AvaloniaResource Remove="Assets\Icons\lizterm.ico" />
    <AvaloniaResource Remove="Assets\Icons\lizterm-small.png" />
    <AvaloniaResource Include="../../THIRD-PARTY-NOTICES.txt" Link="Assets/THIRD-PARTY-NOTICES.txt" />
    <!-- LizTerm's own terms. About is the only place they reach a user: no archive or installer this
         pipeline produces carries a LICENSE file beside the app, so embedding it is what satisfies
         BSD-3-Clause clause 2 for a binary distribution. -->
    <AvaloniaResource Include="../../LICENSE" Link="Assets/LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- Debug only: lets the AvaloniaUI Developer Tools (avdt, also the avalonia_devtools MCP server in .mcp.json) attach to a running app. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../LizTerm.Core/LizTerm.Core.csproj" />
    <ProjectReference Include="../LizTerm.Backend.B3270/LizTerm.Backend.B3270.csproj" />
    <ProjectReference Include="../LizTerm.Backend.Mvsmf/LizTerm.Backend.Mvsmf.csproj" />
  </ItemGroup>

  <!-- The engine's RID and the app's RID are two different values, so the copy needs both.
       Target RID: where the copy lands, and what RuntimeInformation.RuntimeIdentifier will report at run
       time, which is what B3270Locator.Candidates resolves. $(RuntimeIdentifier) when publishing for one,
       the SDK's own when building without one (dotnet run, the test projects, development builds).
       Engine RID: which native/out/ directory the copy reads. The same, except win-arm64: plan 3d settled
       that x3270 4.5ga6 defines no aarch64 Windows host, so win-arm64 ships the win-x64 engine under
       Windows 11's emulation. native/build/verify-bundled-engine.sh spells this mapping too, and its
       negative cases are what prove the two agree. -->
  <PropertyGroup>
    <LizTermTargetRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</LizTermTargetRid>
    <LizTermTargetRid Condition="'$(LizTermTargetRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</LizTermTargetRid>
    <LizTermEngineRid Condition="'$(LizTermTargetRid)' == 'win-arm64'">win-x64</LizTermEngineRid>
    <LizTermEngineRid Condition="'$(LizTermEngineRid)' == ''">$(LizTermTargetRid)</LizTermEngineRid>
  </PropertyGroup>

  <!-- Bundle the built b3270, when native/build/build-macos.sh (or, on Linux, build-linux-docker.sh, or on
       Windows, build-windows-docker.sh) has produced one for this target. Absent, connecting throws
       BackendUnavailableException and LIZTERM_B3270_PATH is the documented development override. -->
  <ItemGroup Condition="Exists('../../native/out/$(LizTermEngineRid)')">
    <None Include="../../native/out/$(LizTermEngineRid)/b3270*"
          Link="runtimes/$(LizTermTargetRid)/native/%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- About wears -DEV unless the build says it is a release, and only release.yml's tag arm says so, with
       -p:LizTermReleaseBuild=true (docs/ci-and-release.md, "Release builds and test builds"). A marker that has
       to be written is the point: the commit the SDK stamps inside a git checkout is absent from a source
       tarball too, so a build that merely lacks one must not pass for a release. The key is
       AppVersion.ReleaseMarkerKey; keep the two in step. -->
  <ItemGroup Condition="'$(LizTermReleaseBuild)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LizTerm.ReleaseBuild</_Parameter1>
      <_Parameter2>true</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LizTerm.App.Tests" />
  </ItemGroup>
</Project>
